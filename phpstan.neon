includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: app/Support/LspSurface.php
        -
            identifier: argument.type
            path: app/Support/LspSurface.php
